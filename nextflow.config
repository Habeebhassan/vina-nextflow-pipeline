/*
========================================================================================
   AutoDock Vina Nextflow Pipeline Config
========================================================================================
*/

params {
    // Input paths
    receptors          = "${projectDir}/assets/receptors.csv"
    ligands            = "${projectDir}/assets/ligands.csv"
    outdir             = "${projectDir}/results"
    
    // Docking defaults
    exhaustiveness     = 8
    num_modes          = 9
}

// Global process configuration
process {
    // Graceful error handling during development: finish remaining tasks before failing
    errorStrategy = 'finish'
    
    // Default resource allocations
    cpus   = 2
    memory = 4.GB
}

// Docker execution profile
profiles {
    docker {
        docker.enabled      = true
        docker.userEmulation = true    // Ensures output files are owned by your user, not root
        docker.autoMounts    = true
    }
}

// Manifest details
manifest {
    name            = 'vina-nextflow-pipeline'
    author          = 'Abibulai Hassan'
    description     = 'Automated Batch Docking Pipeline using Nextflow and Docker'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
}
